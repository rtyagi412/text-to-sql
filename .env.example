APP_NAME=text-to-sql
DEBUG=false

DB_SERVER=localhost,1433
DB_NAME=your_database
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=false

# DeepSeek (extract / map / write stages): OpenAI-format chat API in JSON mode.
DEEPSEEK_API_KEY=
LLM_MODEL=deepseek-flash            # or deepseek-v4-pro
# LLM_MAX_TOKENS=8192
# LLM_TEMPERATURE=0
# LLM_THINKING=false                # thinking mode ignores temperature; JSON mode with thinking is undocumented
# LLM_REASONING_EFFORT=high         # low | high | max, only with LLM_THINKING=true
EXTRACT_PROMPT_VERSION=extract-v1
MAPPING_PROMPT_VERSION=mapping-v1
WRITE_PROMPT_VERSION=write-v1
# Compile each written query on the source database (nothing runs); unreachable server = check skipped
# WRITE_COMPILE_CHECK=true
# Guardrails on the source database (write, approve and /sql/validate): estimated plan and a capped sample run.
# SQL_PLAN_CHECK=true
# SQL_PLAN_WARN_COST=50
# SQL_PLAN_MAX_COST=                # reject plans costlier than this; empty = warn only
# SQL_PLAN_SCAN_MIN_ROWS=100000
# SQL_SAMPLE_CHECK=true             # runs the query as SELECT TOP n ... and rolls back; use a read-only login
# SQL_SAMPLE_ROWS=10
# SQL_SAMPLE_TIMEOUT_SECONDS=30
# SQL_SAMPLE_SLOW_MS=5000
# SQL_SAMPLE_PREVIEW=true           # return the sample rows to the caller (never sent to the model)
REDACT_RITM_DESCRIPTION=true

# Approved RITMs live in the approved_ritms table of the catalog database
# APPROVED_EMBEDDING_MODEL=voyage-4        # embeds the approved pool for similarity; independent of EMBEDDING_MODEL

CATALOG_DB_SERVER=localhost
CATALOG_DB_PORT=5435
CATALOG_DB_NAME=schema_catalog
CATALOG_DB_USER=catalog
CATALOG_DB_PASSWORD=catalog

# Embeddings (Voyage AI) for table retrieval and similar-RITM matching. Changing the model/dimension means
# dropping the catalog tables and re-running POST /catalog/sync.
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-code-4
EMBEDDING_DIM=1024
# Tables join paths must not pass through (lookup / tenant-like tables); "schema.table" or "schema.*", comma-separated.
# Empty: any table that catalog_hub_min_references (5) foreign keys point at.
# CATALOG_HUB_TABLES=ref.*,org.LegalEntity,org.Branch,org.Employee

# SSRS reports (/report/*). Generating an RDL needs only a data source; publishing and subscribing also need the URL and login.
# Web portal root; the REST API is at <SSRS_URL>/api/v2.0
SSRS_URL=http://your-ssrs-host/reports
SSRS_AUTH=ntlm                       # ntlm | basic
SSRS_USERNAME=
SSRS_PASSWORD=
# SSRS_DOMAIN=                       # NTLM: sends DOMAIN\user
# SSRS_VERIFY_TLS=true
SSRS_REPORT_FOLDER=/Text2SQL Reports # must already exist; the login needs Content Manager (or Publisher) on it
# How the RDL reaches its data. Set ONE; the path wins when both are set. Never put a user name or password in the connection string.
SSRS_DATA_SOURCE_PATH=/Data Sources/Banking
# SSRS_CONNECTION_STRING=Server=YOURSERVER;Database=YOURDB;Integrated Security=SSPI;TrustServerCertificate=True
