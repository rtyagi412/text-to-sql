APP_NAME=text-to-sql
DEBUG=false

DB_SERVER=localhost,1433
DB_NAME=your_database
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=false

# DeepSeek (extract / map / write stages): OpenAI-format chat API in JSON mode.
DEEPSEEK_API_KEY=
LLM_MODEL=deepseek-flash            # or deepseek-v4-pro
# LLM_MAX_TOKENS=8192
# LLM_TEMPERATURE=0
# LLM_THINKING=false                # thinking mode ignores temperature; JSON mode with thinking is undocumented
# LLM_REASONING_EFFORT=high         # low | high | max, only with LLM_THINKING=true
EXTRACT_PROMPT_VERSION=extract-v1
MAPPING_PROMPT_VERSION=mapping-v1
WRITE_PROMPT_VERSION=write-v1
# Compile each written query on the source database (nothing runs); unreachable server = check skipped
# WRITE_COMPILE_CHECK=true
REDACT_RITM_DESCRIPTION=true

# Prompt inputs (files at the project root by default)
# APPROVED_RITMS_PATH=approved_ritms.json
# APPROVED_EMBEDDING_MODEL=voyage-4        # embeds the approved pool for similarity; independent of EMBEDDING_MODEL

CATALOG_DB_SERVER=localhost
CATALOG_DB_PORT=5435
CATALOG_DB_NAME=schema_catalog
CATALOG_DB_USER=catalog
CATALOG_DB_PASSWORD=catalog

# Embeddings (Voyage AI) for table retrieval and similar-RITM matching. Changing the model/dimension means
# dropping the catalog tables and re-running POST /catalog/sync.
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-code-4
EMBEDDING_DIM=1024
# Tables join paths must not pass through (lookup / tenant-like tables); "schema.table" or "schema.*", comma-separated.
# Empty: any table that catalog_hub_min_references (5) foreign keys point at.
# CATALOG_HUB_TABLES=ref.*,org.LegalEntity,org.Branch,org.Employee
