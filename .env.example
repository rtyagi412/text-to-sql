APP_NAME=text-to-sql
DEBUG=false

DB_SERVER=localhost,1433
DB_NAME=your_database
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=false

# Claude (SQL generation). Leave ANTHROPIC_API_KEY blank to use the SDK's own credential lookup
# (ANTHROPIC_API_KEY env var or an `ant auth login` profile).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
CLAUDE_MAX_TOKENS=16000
# CLAUDE_EFFORT=high            # low | medium | high | xhigh | max (unset = model default)
EXTRACT_PROMPT_VERSION=extract-v1
MAPPING_PROMPT_VERSION=mapping-v1
WRITE_PROMPT_VERSION=write-v1
REDACT_RITM_SUMMARY=true

# Prompt inputs (files at the project root by default)
# BUSINESS_GLOSSARY_PATH=business_glossary.md
# APPROVED_RITMS_PATH=approved_ritms.json
# APPROVED_EMBEDDING_MODEL=voyage-4        # embeds the approved pool for similarity; independent of EMBEDDING_MODEL

CATALOG_DB_SERVER=localhost
CATALOG_DB_PORT=5435
CATALOG_DB_NAME=schema_catalog
CATALOG_DB_USER=catalog
CATALOG_DB_PASSWORD=catalog

# Embeddings (Voyage AI) for table retrieval and similar-RITM matching. Changing the model/dimension means
# dropping the catalog tables and re-running POST /catalog/sync.
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-code-4
EMBEDDING_DIM=1024
